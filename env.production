# Production Environment Variables
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Database Configuration
DB_HOST=your-production-db-host
DB_PORT=5432
DB_NAME=your-production-db-name
DB_USER=your-production-db-user
DB_PASSWORD=your-production-db-password
DB_DIALECT=postgres

# Twilio Configuration
TWILIO_ACCOUNT_SID=your-production-twilio-account-sid
TWILIO_AUTH_TOKEN=your-production-twilio-auth-token
TWILIO_PHONE_NUMBER=your-production-twilio-phone-number

# JWT Configuration
JWT_SECRET=your-production-jwt-secret-key-here
JWT_EXPIRES_IN=24h

# Socket.IO Configuration
SOCKET_IO_CORS_ORIGIN=https://your-production-domain.com
SOCKET_IO_PATH=/api/socket
NEXT_PUBLIC_SOCKET_URL=https://your-production-domain.com
NEXT_PUBLIC_SOCKET_PATH=/api/socket

# Application Configuration
NEXT_PUBLIC_APP_URL=https://your-production-domain.com
NEXT_PUBLIC_API_URL=https://your-production-domain.com/api

# Security
NEXTAUTH_SECRET=your-production-nextauth-secret
NEXTAUTH_URL=https://your-production-domain.com

# Optional: Redis for production (if using Redis for Socket.IO scaling)
# REDIS_URL=redis://your-redis-host:6379
