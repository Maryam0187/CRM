# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crm_database
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1d

# Twilio Configuration
# Production Credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# IVR Dialer Phone Number (optional)
# If set, IVR dialer will use this number instead of TWILIO_PHONE_NUMBER
# If not set, IVR dialer will use TWILIO_PHONE_NUMBER
TWILIO_IVR_PHONE_NUMBER=+1234567890

# Twilio SIP Domain Configuration (deprecated - using Voice SDK instead)
# TWILIO_SIP_DOMAIN_SID=SDxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_SIP_DOMAIN=crm-sip.sip.us1.twilio.com
# TWILIO_SIP_DEFAULT_DOMAIN=crm-sip.sip.us1.twilio.com

# Test Credentials (for development)
TWILIO_TEST_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TEST_AUTH_TOKEN=your_twilio_test_auth_token

# Webhook Configuration
# For Railway deployment, set this to your Railway app URL
TWILIO_WEBHOOK_BASE_URL=https://crm.itechsoft.net
# Railway automatically provides these, but you can override if needed
# RAILWAY_STATIC_URL=https://crm.itechsoft.net
# RAILWAY_PUBLIC_DOMAIN=crm.itechsoft.net
NEXT_PUBLIC_APP_URL=https://crm.itechsoft.net

# AI outbound calling (Rebecca / OpenAI Realtime)
AI_CALLING_ENABLED=true
OPENAI_API_KEY=sk-...
# gpt-realtime-1.5 = smoother, more natural voice (recommended). Use gpt-realtime for legacy.
OPENAI_REALTIME_MODEL=gpt-realtime-1.5
OPENAI_REALTIME_GA=true
# Rebecca — shimmer = warm feminine (recommended). marin = natural GA; coral = expressive legacy.
OPENAI_REALTIME_VOICE=shimmer
# Higher = more natural variation in pace/phrasing (0.88–0.95). Lower if off-script.
OPENAI_REALTIME_TEMPERATURE=0.92
# Turn-taking on phone lines (ms) — higher silence = waits for customer to finish speaking
# OPENAI_REALTIME_VAD_SILENCE_MS=1000
# OPENAI_REALTIME_VAD_PREFIX_MS=300
# OPENAI_REALTIME_VAD_THRESHOLD=0.5
# WebSocket URL Twilio connects to for AI audio (REQUIRED in production if crm domain blocks WS upgrades)
# Must be the same Node process as server.js (npm start), not serverless-only next start
# AI_MEDIA_STREAM_WS_URL=wss://your-app.up.railway.app/ws/ai-media-stream
# AI_AUTO_START_ON_ANSWER=false
AI_SUPERVISED_CONFERENCE_MODE=false
AI_SUPERVISOR_BROWSER_LISTEN=true
# Live monitor: all customer frames are forwarded (no throttle). AI lane interval (ms):
AI_MONITOR_AI_INTERVAL_MS=40
# Wait for customer hello before Rebecca speaks; if silent this long, Rebecca opens (ms)
AI_CUSTOMER_FIRST_TIMEOUT_MS=10000
# Delay AI audio until this long after true answer (avoids speaking during ring/early media)
AI_POST_ANSWER_GRACE_MS=2000
# Pause ~1s after the customer stops speaking (or before scripted opening) before Rebecca talks
AI_REPLY_DELAY_MS=1000

# Development Mode
TWILIO_TEST_MODE=true

# Call Recording Configuration
# Set to 'true' to enable call recording (default: false)
TWILIO_ENABLE_RECORDING=false

# Encryption Configuration
ENCRYPTION_KEY=your_32_character_encryption_key_here

# App Configuration
NEXT_PUBLIC_APP_NAME=CRM System
NODE_ENV=development

# Activity & Location Tracking (milliseconds)
NEXT_PUBLIC_ACTIVITY_INACTIVITY_TIMEOUT_MS=60000
NEXT_PUBLIC_LOCATION_CHECK_INTERVAL_MS=900000
NEXT_PUBLIC_LOCATION_ERROR_THRESHOLD=2